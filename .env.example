# =============================================================================
# ENVIRONMENT VARIABLES  —  copy this file to `.env.local` and fill it in.
#
#   cp .env.example .env.local
#
# `.env.local` is gitignored. NEVER commit real keys. If you leak one, rotate it
# immediately at the provider console (links below) — a leaked key on a public
# hackathon repo gets scraped and billed within minutes.
#
# THE APP RUNS WITH ZERO CONFIG. With no keys set at all, the backend starts in
# MOCK MODE: an in-memory synthetic dataset + a deterministic fatigue model.
# Every endpoint works. Add keys to upgrade from mock -> real.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. GEMINI  (Google AI Studio)  — THE LLM. This is the one that matters.
# -----------------------------------------------------------------------------
# Used for: fatigue reasoning, assignment recommendations, and mapping free-text
# procedure names ("redo aortic valve replacement") to a complexity tier.
#
# HOW TO SIGN UP (free tier, ~60 seconds, no credit card required):
#   1. Go to  https://aistudio.google.com/apikey
#   2. Sign in with any Google account.
#   3. Click "Create API key". Pick "Create API key in new project" if you have
#      no Google Cloud project — AI Studio makes one for you.
#   4. Copy the key (starts with "AIza...") and paste it below.
#
# FREE TIER LIMITS (as of writing — verify at the link below, Google changes these):
#   Gemini Flash models: generous free requests/minute and requests/day, enough
#   for a hackathon demo. Pro models have a much tighter free quota.
#   Current limits:  https://ai.google.dev/gemini-api/docs/rate-limits
#   Pricing:         https://ai.google.dev/pricing
#
# NOTE: aistudio.google.com is not available in every country. If it is blocked
# for you, the same models are reachable through Google Cloud Vertex AI (needs a
# billing account), or just leave this blank and run on the deterministic model.
GEMINI_API_KEY=

# Which Gemini model to call. Flash = fast + cheap + big free tier (use this for
# the demo). Pro = smarter, slower, tighter free quota.
# See the current model list at https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-2.5-flash


# -----------------------------------------------------------------------------
# 2. LLM PROVIDER SWITCH
# -----------------------------------------------------------------------------
# One line to change which LLM backs every AI endpoint. Options:
#
#   gemini     -> Google Gemini      (default; needs GEMINI_API_KEY above)
#   anthropic  -> Claude             (needs ANTHROPIC_API_KEY below)
#   none       -> skip the LLM entirely, always use the deterministic fallback
#
# Leaving this unset behaves as "gemini", and gemini itself degrades to the
# deterministic model if GEMINI_API_KEY is missing. So it is always safe.
LLM_PROVIDER=gemini


# -----------------------------------------------------------------------------
# 3. ANTHROPIC / CLAUDE  (optional — alternate provider)
# -----------------------------------------------------------------------------
# Only needed if you set LLM_PROVIDER=anthropic. The pitch deck references
# Claude, so this is here so you can flip providers in one line without a
# rewrite. Requires the optional dep:  npm install @anthropic-ai/sdk
#
# HOW TO SIGN UP:
#   1. Go to  https://console.anthropic.com/
#   2. Create an account, then open Settings -> API Keys -> "Create Key".
#   3. Copy the key (starts with "sk-ant-...").
#   NOTE: Anthropic has no permanent free tier. New accounts usually get a small
#   trial credit; past that you must add a payment method under Billing.
#   Pricing: https://www.anthropic.com/pricing
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5


# -----------------------------------------------------------------------------
# 4. SUPABASE  (Postgres database)
# -----------------------------------------------------------------------------
# The "hospital database". Leave BOTH blank to run on the in-memory mock store —
# the app is fully functional without Supabase, you just lose persistence
# (data resets on server restart).
#
# HOW TO SIGN UP (free tier, no credit card):
#   1. Go to  https://supabase.com/dashboard  and sign in with GitHub.
#   2. "New project". Pick a name, generate a DB password (save it somewhere),
#      choose the region closest to you. Provisioning takes ~2 minutes.
#   3. Open the SQL Editor (left sidebar), paste the contents of
#      `scripts/schema.sql`, and click Run.
#   4. Go to Project Settings -> API (or "API Keys") and copy:
#        - "Project URL"        -> SUPABASE_URL below
#        - "service_role" key   -> SUPABASE_SERVICE_ROLE_KEY below
#   5. Fill both in below, then populate the tables:   npm run seed
#
# ⚠️  SECURITY: the service_role key BYPASSES ROW LEVEL SECURITY. It is a full
#     admin key. It must ONLY ever live in server-side code (these API routes
#     are server-side, so this is fine) and in your Vercel env vars. Never give
#     it a NEXT_PUBLIC_ prefix, never import it into a React component, never
#     commit it. If it leaks, rotate it in the Supabase dashboard immediately.
#
#     We use service_role here because this demo has no real auth and the API
#     routes enforce access control themselves (see lib/privacy.js). In a real
#     deployment you would use the anon key + Row Level Security policies +
#     Supabase Auth, and RLS would enforce the privacy rules at the DB layer.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=


# -----------------------------------------------------------------------------
# 5. VERCEL  (hosting)  — no env var needed, but here's the setup
# -----------------------------------------------------------------------------
# HOW TO SIGN UP + DEPLOY:
#   1. Go to  https://vercel.com/signup  and sign in with GitHub (free "Hobby"
#      plan, no credit card).
#   2. "Add New... -> Project", import this GitHub repo.
#   3. Framework preset auto-detects as Next.js. Don't change the build settings.
#   4. BEFORE clicking Deploy, expand "Environment Variables" and add every
#      non-blank variable from your .env.local (GEMINI_API_KEY, SUPABASE_URL,
#      SUPABASE_SERVICE_ROLE_KEY, ...). Vercel does NOT read your .env.local.
#   5. Deploy. You get a live URL in ~60s. Every push to `main` redeploys.
#
#   If you add env vars AFTER the first deploy you must redeploy for them to
#   take effect (Deployments -> ... -> Redeploy).


# -----------------------------------------------------------------------------
# 6. WHOOP  (wearable recovery data)  — ROADMAP, NOT WIRED UP
# -----------------------------------------------------------------------------
# Not implemented. Listed here because the pitch names it, and judges will ask
# "is this real?" — the honest answer is: sleep data currently comes from manual
# logging + the synthetic seed. This is the documented path to real data.
#
# HOW TO SIGN UP (for after the hackathon):
#   1. You need a WHOOP membership/device to test against real data.
#   2. Go to  https://developer.whoop.com/  and register as a developer.
#   3. Create an app in the developer dashboard to get a client ID + secret.
#      You must declare an OAuth redirect URI (e.g. your Vercel URL + /api/whoop/callback).
#   4. WHOOP uses OAuth 2.0 — the surgeon authorizes your app, you exchange the
#      code for an access token, then read the Recovery + Sleep endpoints.
#      Docs: https://developer.whoop.com/docs/
#   5. Relevant scopes for this app: read:recovery, read:sleep, read:profile.
#
# Alternative wearables with similar APIs, if WHOOP access is a blocker:
#   Oura     -> https://cloud.ouraring.com/v2/docs  (personal access token, very easy)
#   Fitbit   -> https://dev.fitbit.com/
#   Apple Health -> no web API; requires a native iOS app using HealthKit.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=


# -----------------------------------------------------------------------------
# 7. DEMO / SAFETY TOGGLES
# -----------------------------------------------------------------------------
# Because there is no auth in this demo, the caller declares who they are via
# the `x-viewer-id` / `x-viewer-role` request headers. That is obviously
# spoofable and is NOT acceptable in production — it exists so the frontend can
# use a "View as: Dr. Chen / OR Director" dropdown without building login.
# Set to "true" only if you want to hard-disable the header override.
REQUIRE_REAL_AUTH=false

# Seconds a computed fatigue score is considered fresh before we recompute.
# Keeps the demo snappy and avoids burning LLM quota on every page refresh.
FATIGUE_CACHE_TTL_SECONDS=120
